# Kopiere diese Datei nach .env und trage deine Werte ein. .env wird nicht ins Repository übernommen.
# Supabase: im Projekt oben auf „Connect“ (oder Project Settings → API Keys). Als Schlüssel den Publishable key
# (sb_publishable_…) eintragen; bei älteren Projekten geht auch der anon key.
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=DEIN-PUBLISHABLE-KEY

# Website, Kontakt und Impressum stehen in src/data/site.json (https://trainerstab.app). Datenschutz und Impressum
# öffnet die App standardmäßig dort; nur setzen, wenn die Texte woanders liegen:
# EXPO_PUBLIC_PRIVACY_URL=https://trainerstab.app/datenschutz
# EXPO_PUBLIC_IMPRINT_URL=https://trainerstab.app/impressum

# Expo/EAS: Projekt-ID aus dem Expo-Dashboard (Projekt im Browser anlegen, siehe SETUP.md Schritt 5)
EAS_PROJECT_ID=

# Absturzberichte (Sentry, Speicherort EU) – ohne DSN keine Berichte
EXPO_PUBLIC_SENTRY_DSN=

# Einladen: Links zur Testversion (TestFlight, Google Play Test); leer = Links aus src/data/site.json
EXPO_PUBLIC_INSTALL_IOS=
EXPO_PUBLIC_INSTALL_ANDROID=
# Einladungslinks zeigen auf die Website (https://trainerstab.app/join?code=…). Nur zum Testen ohne Website leer
# setzen – dann öffnen die Links direkt die App (trainerstab://…):
# EXPO_PUBLIC_INVITE_URL=

# Optional: eigene Bundle-ID (Standard: app.trainerstab – nach dem ersten Upload nicht mehr ändern)
# APP_BUNDLE_ID=app.trainerstab
