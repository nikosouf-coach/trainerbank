# Kopiere diese Datei nach .env und trage deine Werte ein. .env wird nicht ins Repository übernommen.
# Supabase: Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-KEY

# Öffentliche Rechtstexte (Website des Vereins / der Academy)
EXPO_PUBLIC_PRIVACY_URL=https://www.goatsocceracademy.de/trainerbank/datenschutz
EXPO_PUBLIC_IMPRINT_URL=https://www.goatsocceracademy.de/impressum

# Expo/EAS: nach `eas init` steht die Projekt-ID im Expo-Dashboard
EAS_PROJECT_ID=

# Optional: eigene Bundle-ID (Standard: de.goatsocceracademy.trainerbank)
# APP_BUNDLE_ID=de.goatsocceracademy.trainerbank
